rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Generation history is written ONLY by Cloud Functions (Admin SDK bypasses
    // these rules). Clients may read their own history, and may never write.
    match /generations/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Per-user daily usage counters are managed by Cloud Functions only.
    match /usage/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // A user owns their own users/{uid} tree. Cross-user access is always denied.
    match /users/{uid} {
      // Profile document itself.
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Conversations + messages: the client reads and writes its own chat history.
      match /conversations/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Library assets (generated images, edited images, uploaded files): the
      // client reads and writes its own index of created/uploaded assets.
      match /assets/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Memory profile: client-READ-ONLY. All writes/deletes go through Cloud
      // Functions (Admin SDK bypasses these rules) so the model's stored context
      // can't be forged or tampered with from the client.
      match /memory/{document=**} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
